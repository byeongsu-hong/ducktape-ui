recipe ghost_action for button
  @text-12.5px font-semibold px-10px py-6px bg-transparent text-muted rounded-8px hover:bg-hover pressed:bg-pressed disabled:opacity-50

recipe primary_action for button
  @text-12.5px font-semibold px-14px py-8px bg-primary text-white rounded-8px hover:bg-primary/90 pressed:bg-primary/75 disabled:opacity-50

recipe secondary_action for button
  @text-12.5px font-semibold px-14px py-8px bg-surface text-fg border border-border rounded-8px hover:bg-hover pressed:bg-pressed disabled:opacity-50

recipe danger_action for button
  @text-12.5px font-semibold px-14px py-8px bg-danger text-white rounded-8px hover:bg-danger/90 pressed:bg-danger/75 disabled:opacity-50
