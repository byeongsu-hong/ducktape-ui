recipe page for col
  @w-full h-full p-8 gap-6 bg-bg

recipe content for col
  @w-full gap-6

recipe section for col
  @w-full gap-4

recipe field for col
  @w-full gap-2

recipe cluster for row
  @w-full gap-2 items-center

recipe toolbar for row
  @w-full gap-3 items-center

recipe panel for box
  @w-full p-5 bg-surface border border-border rounded-lg overflow-hidden

recipe surface for box
  @w-full p-4 bg-surface border border-border rounded-md

recipe inset for box
  @w-full p-4 bg-muted_bg rounded-md

recipe display for text
  @text-2xl leading-tight font-bold text-fg

recipe heading for text
  @text-xl leading-snug font-bold text-fg

recipe subheading for text
  @text-lg leading-snug font-bold text-fg

recipe body for text
  @text-sm leading-normal text-fg

recipe label for text
  @text-sm leading-snug font-bold text-fg

recipe muted for text
  @text-sm leading-normal text-muted

recipe caption for text
  @text-xs leading-normal text-muted

recipe control for input
  @w-full px-3 py-2 bg-surface border border-input rounded-md focus:border-ring

recipe primary_action for button
  @px-4 py-2 bg-primary text-primary_fg rounded-md hover:bg-primary/90 pressed:bg-primary/80 disabled:opacity-50

recipe secondary_action for button
  @px-4 py-2 bg-secondary text-secondary_fg rounded-md hover:bg-accent pressed:bg-border disabled:opacity-50

recipe outline_action for button
  @px-4 py-2 bg-surface text-fg border border-border rounded-md hover:bg-accent pressed:bg-border disabled:opacity-50

recipe ghost_action for button
  @px-3 py-2 bg-transparent text-fg rounded-md hover:bg-accent pressed:bg-border disabled:opacity-50

recipe danger_action for button
  @px-4 py-2 bg-danger text-danger_fg rounded-md hover:bg-danger/90 pressed:bg-danger/80 disabled:opacity-50
